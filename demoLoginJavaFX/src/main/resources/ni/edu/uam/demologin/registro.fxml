<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.demologin.controller.RegistroController">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
    <content>
    <VBox spacing="10" AnchorPane.bottomAnchor="15" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="15">
       <Label style="-fx-font-size:24px;-fx-font-width: bold;" text="REGISTROS DE USUARIOS" />
       <GridPane hgap="10" prefHeight="428.0" prefWidth="537.0" vgap="10">
           <columnConstraints>
               <ColumnConstraints prefWidth="150.0" />
                  <ColumnConstraints />
                  <ColumnConstraints />
           </columnConstraints>
           <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
           <TextField fx:id="txtNombre" GridPane.columnIndex="0" GridPane.rowIndex="1" />
           <Label text="Apellido" GridPane.columnIndex="1" GridPane.rowIndex="0" />
           <TextField fx:id="txtApellido" GridPane.columnIndex="1" GridPane.rowIndex="1" />
           <HBox alignment="CENTER" spacing="15" GridPane.columnIndex="2" GridPane.rowIndex="0" />
           <Button maxWidth="Infinity" onAction="#seleccionarFoto" text="SELECCIONAR FOTO" GridPane.columnIndex="2" GridPane.rowIndex="0" />
           <ImageView fx:id="imageFoto" fitHeight="120" fitWidth="120" preserveRatio="true" GridPane.columnIndex="2" GridPane.rowIndex="1" />
           <Label text="Correo" GridPane.columnIndex="0" GridPane.rowIndex="2" />
           <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.rowIndex="6" />
           <Label text="Usuario" GridPane.rowIndex="7" />
           <TextField fx:id="txtUsuario" GridPane.columnSpan="2" GridPane.rowIndex="8" />
           <Label text="Contraseña" GridPane.rowIndex="9" />
           <PasswordField fx:id="txtPassword" GridPane.columnSpan="2" GridPane.rowIndex="10" />
           <Label text="Confirmar Contraseña" GridPane.rowIndex="11" />
           <PasswordField fx:id="txtConfirmaPassword" GridPane.columnSpan="2" GridPane.rowIndex="12" />
       </GridPane>
        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#registrar" prefWidth="150" text="REGISTRAR" />
            <Button onAction="#regresar" prefWidth="150" text="REGRESAR" />
        </HBox>

    </VBox>
    </content>
    </ScrollPane>
</AnchorPane>
