<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pantalla que muestra todos los usuarios en una tabla -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.demologin.controller.UsuariosController"
      spacing="15"
      alignment="CENTER"
      prefWidth="800"
      prefHeight="450">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Encabezado y botón para registrar usuarios -->
    <HBox alignment="CENTER_LEFT" spacing="10">

        <Label text="LISTA DE USUARIOS"
               style="-fx-font-size: 24px;"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <Button text="Registrar"
                onAction="#registrarUsuario"/>

    </HBox>

    <!-- Tabla que muestra los usuarios registrados -->
    <TableView fx:id="tablaUsuarios"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="130"/>

            <TableColumn fx:id="colApellido"
                         text="Apellido"
                         prefWidth="130"/>

            <TableColumn fx:id="colUsuario"
                         text="Usuario"
                         prefWidth="120"/>

            <TableColumn fx:id="colCorreo"
                         text="Correo"
                         prefWidth="180"/>

            <!-- Los botones se generan desde UsuariosController -->
            <TableColumn fx:id="colAcciones"
                         text="Acciones"
                         prefWidth="190"
                         sortable="false"
                         resizable="false"/>

        </columns>

        <!-- Ajusta las columnas al ancho disponible -->
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

    </TableView>

</VBox>
